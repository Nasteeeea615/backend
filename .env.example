PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=septik_service
DB_USER=postgres
DB_PASSWORD=your_password

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# SMS Gateway
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key
SMS_GATEWAY_URL=https://api.sms.ru/sms/send

# Payment Gateway (YooKassa)
PAYMENT_GATEWAY_API_KEY=your_payment_gateway_api_key
PAYMENT_GATEWAY_SHOP_ID=your_shop_id
PAYMENT_GATEWAY_URL=https://api.yookassa.ru/v3

# Firebase Cloud Messaging
# Get this from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# Store the entire JSON content as a single line string
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}
